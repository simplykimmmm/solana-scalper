{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "cleanUrls": true,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/status",
      "destination": "/api/bridge?route=status"
    },
    {
      "source": "/api/control",
      "destination": "/api/bridge?route=control"
    },
    {
      "source": "/api/agent/status",
      "destination": "/api/bridge?route=agent-status"
    },
    {
      "source": "/api/agent/poll",
      "destination": "/api/bridge?route=agent-poll"
    },
    {
      "source": "/",
      "destination": "/remote-dashboard/index"
    },
    {
      "source": "/index.html",
      "destination": "/remote-dashboard/index"
    }
  ]
}
